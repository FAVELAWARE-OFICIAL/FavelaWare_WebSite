{
  "name": "git-flow-branch-naming",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/main",
        "refs/heads/develop"
      ]
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "git-flow naming",
        "operator": "regex",
        "pattern": "^(feature|feat|fix|bugfix|release|hotfix|support|chore|docs|refactor|test|perf|ci|build)/.+$",
        "negate": false
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 19707092,
      "actor_type": "Team",
      "bypass_mode": "always"
    }
  ]
}
